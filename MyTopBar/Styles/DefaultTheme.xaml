<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        自定义字体：Assets/Fonts 下随包了 HarmonyOS Sans SC 的 Light(300) / Regular(400) /
        Medium(500) / Bold(700) / Black(900) 五档，它们的 FamilyName 同为 "HarmonyOS Sans SC"，
        WPF 完全靠 FontWeight 选字形。
        因此这里只声明 family，字重一律由使用处的 FontWeight 指定，不要再写死某个字重的 Family
        （例如 "#HarmonyOS Sans SC Medium"：那样会把 FontWeight 锁死在 Medium，
         继承它的 SemiBold/Bold/Light 全部失效）。
        注意：没有 SemiBold(600) 字形，SemiBold/DemiBold 会被吸附到 Bold(700)，并非半粗。
    -->
    <FontFamily x:Key="AppFont">pack://application:,,,/Assets/Fonts/#HarmonyOS Sans SC</FontFamily>

    <!--
        ==========  字重令牌  ==========
        只用「真实字形」的档位：Light(300) / Regular(400) / Medium(500) / Bold(700) / Black(900)。
        不要在这里出现 SemiBold(600) / ExtraBold(800) —— 没有对应字形，WPF 会吸附到邻档，
        写 600 得到的是 500（不是半粗），写 800 得到的是 700，容易误判。

        命名按"语义用途"而非数值，字号与字重解耦：
        同一语义在不同字号下复用同一个令牌，视觉层级才稳定。
        用法：<Setter Property="FontWeight" Value="{StaticResource FontWeightEmphasis}" />
        直接写 FontWeight="Bold" 也能工作，但会绕开这份清单，新代码请用令牌。
    -->
    <FontWeight x:Key="FontWeightCaption">Light</FontWeight>
    <FontWeight x:Key="FontWeightBody">Normal</FontWeight>
    <FontWeight x:Key="FontWeightEmphasis">Medium</FontWeight>
    <FontWeight x:Key="FontWeightHeading">Bold</FontWeight>
    <FontWeight x:Key="FontWeightDisplay">Black</FontWeight>

    <!--  弹窗容器：浅色为基准，深色由 ThemeService.ApplyBrushes 覆盖  -->
    <SolidColorBrush x:Key="MenuBackgroundBrush" Color="#FFF7F7F7" />

    <SolidColorBrush x:Key="MenuBorderBrush" Color="#26000000" />

    <SolidColorBrush x:Key="MenuForegroundBrush" Color="#E6000000" />

    <SolidColorBrush x:Key="MenuSecondaryForegroundBrush" Color="#80000000" />

    <SolidColorBrush x:Key="MenuHoverBrush" Color="#1A000000" />

    <SolidColorBrush x:Key="MenuPressedBrush" Color="#33000000" />

    <SolidColorBrush x:Key="MenuHoverForegroundBrush" Color="White" />

    <SolidColorBrush x:Key="MenuSeparatorBrush" Color="#18000000" />

    <!--  日历今天高亮  -->
    <SolidColorBrush x:Key="CalendarTodayBrush" Color="#FF0A84FF" />

    <SolidColorBrush x:Key="CalendarTodayForegroundBrush" Color="#FFFFFFFF" />

    <!--
        弹窗的毛玻璃底色。必须接近透明——不透明会把模糊层完全盖住。
        保留极淡的一层只为让文字有个稳定的对比基底。
        由 ThemeService.ApplyBrushes 按明暗覆盖。
    -->
    <SolidColorBrush x:Key="PopupGlassBrush" Color="#14FFFFFF" />

    <!--  输入控件（设置窗口）：WPF 默认模板不跟随主题，必须显式指定  -->
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="#FFFFFFFF" />

    <SolidColorBrush x:Key="InputForegroundBrush" Color="#E6000000" />

    <SolidColorBrush x:Key="InputBorderBrush" Color="#33000000" />

    <SolidColorBrush x:Key="InputBorderHoverBrush" Color="#59000000" />

    <!--  强调色：默认沿用 macOS 蓝  -->
    <SolidColorBrush x:Key="AccentBrush" Color="#FF0A84FF" />

    <SolidColorBrush x:Key="AccentForegroundBrush" Color="#FFFFFFFF" />

    <SolidColorBrush x:Key="AccentSoftBrush" Color="#330A84FF" />

    <!--  顶栏组件前景色：浅色主题基准，深色切换时由 ThemeService 覆盖  -->
    <SolidColorBrush x:Key="BarForegroundBrush" Color="#E6000000" />

    <SolidColorBrush x:Key="BarSecondaryForegroundBrush" Color="#99000000" />

    <!--
        分隔线：需要比前景色更淡但仍可辨识。
        浅色模式 #1A000000（10% 黑）→ 在白色壁纸上有足够对比度
        深色模式由 ThemeService.ApplyBrushes 覆盖为 #33FFFFFF（20% 白）
    -->
    <SolidColorBrush x:Key="BarSeparatorBrush" Color="#1A000000" />

    <Style TargetType="Window">
        <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="RenderOptions.ClearTypeHint" Value="Enabled" />
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
    </Style>

    <Style TargetType="TextBlock">
        <Setter Property="RenderOptions.ClearTypeHint" Value="Enabled" />
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
    </Style>

    <Style x:Key="AppleMenuButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Padding" Value="8,0" />
        <Setter Property="Foreground" Value="{DynamicResource BarForegroundBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root"
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            CornerRadius="4">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource MenuHoverBrush}" />
                        </Trigger>

                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource MenuPressedBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="AppleMenuItem" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="Foreground" Value="{DynamicResource MenuForegroundBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root"
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            CornerRadius="4">
                        <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" />
                    </Border>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource MenuHoverBrush}" />
                        </Trigger>

                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource MenuPressedBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="AppleMenuSeparator" TargetType="Separator">
        <Setter Property="Margin" Value="8,4" />
        <Setter Property="Background" Value="{DynamicResource MenuSeparatorBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Separator">
                    <Border Height="1" Background="{TemplateBinding Background}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
