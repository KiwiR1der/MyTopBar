<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:common="clr-namespace:MyTopBar.Infrastructure.Common"
                    xmlns:controls="clr-namespace:MyTopBar.Controls"
                    xmlns:widgets="clr-namespace:MyTopBar.Widgets">

    <common:WeatherIconConverter x:Key="WeatherIconConverter" />

    <!--  顶栏内所有组件共用的文字样式  -->
    <Style x:Key="BarText" TargetType="TextBlock">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
        <Setter Property="FontWeight" Value="{StaticResource FontWeightEmphasis}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Foreground" Value="{DynamicResource BarForegroundBrush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="TextWrapping" Value="NoWrap" />
        <Setter Property="RenderOptions.ClearTypeHint" Value="Enabled" />
    </Style>

    <Style x:Key="BarSecondaryText" BasedOn="{StaticResource BarText}" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource BarSecondaryForegroundBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="{StaticResource FontWeightBody}" />
    </Style>

    <!--  组件之间的细分隔线  -->
    <Style x:Key="WidgetSeparator" TargetType="Border">
        <Setter Property="Width" Value="1" />
        <Setter Property="Height" Value="11" />
        <Setter Property="Margin" Value="9,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Background" Value="{DynamicResource BarSeparatorBrush}" />
    </Style>

    <!--  中区：时钟  -->
    <DataTemplate DataType="{x:Type widgets:ClockWidgetViewModel}">
        <TextBlock Cursor="Hand"
                   Style="{StaticResource BarText}"
                   Text="{Binding ClockText}"
                   ToolTip="点击查看日历" />
    </DataTemplate>

    <!--
        中区：歌词（行切换时淡入，FadeTextBlock 自带 150ms 动画）
        Cursor="Hand" 提示可点击 —— 点击弹出媒体控制浮窗。
    -->
    <DataTemplate DataType="{x:Type widgets:LyricsWidgetViewModel}">
        <StackPanel Cursor="Hand"
                    Orientation="Horizontal"
                    VerticalAlignment="Center"
                    ToolTip="点击打开播放控制">
            <controls:FadeTextBlock MaxWidth="320"
                                    Style="{StaticResource BarText}"
                                    Text="{Binding Text}" />
            <controls:FadeTextBlock Margin="8,0,0,0"
                                    Style="{StaticResource BarSecondaryText}"
                                    Text="{Binding NextText}" />
        </StackPanel>
    </DataTemplate>

    <!--  中区：天气（图标用彩色矢量 DrawingImage，不再用 emoji 字体）  -->
    <DataTemplate DataType="{x:Type widgets:WeatherWidgetViewModel}">
        <StackPanel Cursor="Hand"
                    Orientation="Horizontal"
                    VerticalAlignment="Center"
                    ToolTip="点击查看天气详情">
            <Image Width="16"
                   Height="16"
                   VerticalAlignment="Center"
                   Source="{Binding Icon, Converter={StaticResource WeatherIconConverter}}" />
            <TextBlock Margin="4,0,0,0" Style="{StaticResource BarText}" Text="{Binding Text}" />
        </StackPanel>
    </DataTemplate>

    <!--  中区：文本 / 一言  -->
    <DataTemplate DataType="{x:Type widgets:TextWidgetViewModel}">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock MaxWidth="420"
                       Style="{StaticResource BarText}"
                       Text="{Binding Text}"
                       ToolTip="{Binding Source}" />
        </StackPanel>
    </DataTemplate>

    <!--  右区：CPU / 内存（可点击看详情） / 网络  -->
    <DataTemplate DataType="{x:Type widgets:CpuWidgetViewModel}">
        <TextBlock Cursor="Hand"
                   Style="{StaticResource BarSecondaryText}"
                   Text="{Binding Text}"
                   ToolTip="点击查看 CPU 详情" />
    </DataTemplate>

    <DataTemplate DataType="{x:Type widgets:MemoryWidgetViewModel}">
        <TextBlock Cursor="Hand"
                   Style="{StaticResource BarSecondaryText}"
                   Text="{Binding Text}"
                   ToolTip="点击查看内存详情" />
    </DataTemplate>

    <DataTemplate DataType="{x:Type widgets:NetworkWidgetViewModel}">
        <TextBlock Style="{StaticResource BarSecondaryText}" Text="{Binding Text}" />
    </DataTemplate>

    <!--  每个组件统一的外边距  -->
    <Style x:Key="WidgetItem" TargetType="ContentPresenter">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="0,0,2,0" />
    </Style>

</ResourceDictionary>
