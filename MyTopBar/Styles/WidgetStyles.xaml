<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:common="clr-namespace:MyTopBar.Infrastructure.Common"
                    xmlns:controls="clr-namespace:MyTopBar.Controls"
                    xmlns:widgets="clr-namespace:MyTopBar.Widgets">

    <common:WeatherIconConverter x:Key="WeatherIconConverter" />
    <common:IconKeyToImageConverter x:Key="GaugeIconConverter" />
    <!--  顶栏内所有组件共用的文字样式  -->
    <Style x:Key="BarText" TargetType="TextBlock">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="FontFamily" Value="{DynamicResource AppFont}" />
        <Setter Property="FontWeight" Value="{StaticResource FontWeightBody}" />
        <Setter Property="FontSize" Value="{DynamicResource AppFontSize}" />
        <Setter Property="Foreground" Value="{DynamicResource BarForegroundBrush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="TextWrapping" Value="NoWrap" />
    </Style>

    <Style x:Key="BarSecondaryText" BasedOn="{StaticResource BarText}" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource BarSecondaryForegroundBrush}" />
        <Setter Property="FontFamily" Value="{DynamicResource AppFont}" />
        <Setter Property="FontSize" Value="{DynamicResource AppFontSizeSmall}" />
        <Setter Property="FontWeight" Value="{StaticResource FontWeightBody}" />
    </Style>

    <!--
        右区指标组件（CPU / 内存 / 网络）共用的图标与文字样式。
        与天气组件保持一致：图标 16x16，与文字间距 4。
        图标本体在 GaugeIcons.xaml，颜色写死，深浅主题下都清晰。
    -->
    <Style x:Key="WidgetIcon" TargetType="Image">
        <Setter Property="Width" Value="16" />
        <Setter Property="Height" Value="16" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="RenderOptions.BitmapScalingMode" Value="HighQuality" />
    </Style>

    <Style x:Key="WidgetIconText" BasedOn="{StaticResource BarSecondaryText}" TargetType="TextBlock">
        <Setter Property="Margin" Value="4,0,0,0" />
    </Style>

    <!--  中区：时钟  -->
    <DataTemplate DataType="{x:Type widgets:ClockWidgetViewModel}">
        <TextBlock Cursor="Hand"
                   Style="{StaticResource BarText}"
                   Text="{Binding ClockText}"
                   ToolTip="点击查看日历" />
    </DataTemplate>

    <!--
        中区：歌词（行切换时淡入，FadeTextBlock 自带 150ms 动画）
        Cursor="Hand" 提示可点击 —— 点击弹出媒体控制浮窗。
    -->
    <DataTemplate DataType="{x:Type widgets:LyricsWidgetViewModel}">
        <StackPanel Cursor="Hand"
                    Orientation="Horizontal"
                    VerticalAlignment="Center"
                    ToolTip="点击打开播放控制">
            <controls:FadeTextBlock MaxWidth="320"
                                    Style="{StaticResource BarText}"
                                    Text="{Binding Text}" />
            <controls:FadeTextBlock Margin="8,0,0,0"
                                    Style="{StaticResource BarSecondaryText}"
                                    Text="{Binding NextText}" />
        </StackPanel>
    </DataTemplate>

    <!--  中区：天气（图标用彩色矢量 DrawingImage，不再用 emoji 字体）  -->
    <DataTemplate DataType="{x:Type widgets:WeatherWidgetViewModel}">
        <StackPanel Cursor="Hand"
                    Orientation="Horizontal"
                    VerticalAlignment="Center"
                    ToolTip="点击查看天气详情">
            <Image Width="16"
                   Height="16"
                   VerticalAlignment="Center"
                   Source="{Binding Icon, Converter={StaticResource WeatherIconConverter}}" />
            <TextBlock Margin="4,0,0,0" Style="{StaticResource BarText}" Text="{Binding Text}" />
        </StackPanel>
    </DataTemplate>

    <!--  中区：文本 / 一言  -->
    <DataTemplate DataType="{x:Type widgets:TextWidgetViewModel}">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock MaxWidth="420"
                       Style="{StaticResource BarText}"
                       Text="{Binding Text}"
                       ToolTip="{Binding Source}" />
        </StackPanel>
    </DataTemplate>

    <!--
        右区：CPU / 内存（可点击看详情） / 网络。
        三者结构一致（图标 + 数值），差异只有 ToolTip 与是否可点，
        故共用上面的 WidgetIcon / WidgetIconText 样式。
    -->
    <DataTemplate DataType="{x:Type widgets:CpuWidgetViewModel}">
        <StackPanel Cursor="Hand"
                    Orientation="Horizontal"
                    VerticalAlignment="Center"
                    ToolTip="点击查看 CPU 详情">
            <Image Source="{Binding Icon, Converter={StaticResource GaugeIconConverter}}" Style="{StaticResource WidgetIcon}" />
            <TextBlock Style="{StaticResource WidgetIconText}" Text="{Binding Text}" />
        </StackPanel>
    </DataTemplate>

    <DataTemplate DataType="{x:Type widgets:MemoryWidgetViewModel}">
        <StackPanel Cursor="Hand"
                    Orientation="Horizontal"
                    VerticalAlignment="Center"
                    ToolTip="点击查看内存详情">
            <Image Source="{Binding Icon, Converter={StaticResource GaugeIconConverter}}" Style="{StaticResource WidgetIcon}" />
            <TextBlock Style="{StaticResource WidgetIconText}" Text="{Binding Text}" />
        </StackPanel>
    </DataTemplate>

    <DataTemplate DataType="{x:Type widgets:NetworkWidgetViewModel}">
        <StackPanel Orientation="Horizontal"
                    VerticalAlignment="Center"
                    ToolTip="下行 / 上行">
            <Image Source="{Binding Icon, Converter={StaticResource GaugeIconConverter}}" Style="{StaticResource WidgetIcon}" />
            <TextBlock Style="{StaticResource WidgetIconText}" Text="{Binding Text}" />
        </StackPanel>
    </DataTemplate>
</ResourceDictionary>
