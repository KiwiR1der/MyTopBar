<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        顶栏系统指标组件的彩色图标（CPU / 内存 / 网络 / 音量）。

        与 WeatherIcons.xaml 同一套做法与视觉语言：
        - 每个图标是 DrawingImage，直接作为 Image.Source
        - viewBox 统一 0 0 1024 1024，实际渲染 16x16
        - 颜色写死，不随明暗主题变化（和天气图标一致），
          因此在深色与浅色毛玻璃上都可辨识
        - 用多层 GeometryDrawing 叠出高光 + 主体 + 描边的层次，
          而不是单色剪影——这是「好看」与「能用」的分界

        尺寸约定：图形主体控制在 viewBox 中间约 700x700 的区域，
        四周留白，避免 16px 下贴边糊成一块。

        key 命名 SFSymbol 风格：GaugeIcon_xxx，由 IconKeyToImageConverter
        统一查找（见 Infrastructure/Common/IconKeyToImageConverter.cs）。
    -->

    <!-- =====  CPU：表盘 + 指针  =====  -->
    <DrawingImage x:Key="GaugeIcon_cpu">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <!--  刻度盘底：深色环  -->
                <GeometryDrawing Brush="#FF3D4265">
                    <GeometryDrawing.Geometry>
                        <PathGeometry Figures="M512 128A384 384 0 1 0 512 896A384 384 0 1 0 512 128Z" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <!--  内圈：浅灰盘面，做出「凹陷」层次  -->
                <GeometryDrawing Brush="#FFEEF1F8">
                    <GeometryDrawing.Geometry>
                        <PathGeometry Figures="M512 208A304 304 0 1 0 512 816A304 304 0 1 0 512 208Z" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>

                <!--
                    刻度：12 / 3 / 6 / 9 点四个方向。
                    16px 下 32 宽的刻度几乎看不见，这里加粗到 44 并延长。
                -->
                <GeometryDrawing Brush="#FF7094F3">
                    <GeometryDrawing.Geometry>
                        <GeometryGroup>
                            <RectangleGeometry Rect="490,232,44,116" RadiusX="22" RadiusY="22" />
                            <RectangleGeometry Rect="676,490,116,44" RadiusX="22" RadiusY="22" />
                            <RectangleGeometry Rect="232,490,116,44" RadiusX="22" RadiusY="22" />
                            <RectangleGeometry Rect="490,676,44,116" RadiusX="22" RadiusY="22" />
                        </GeometryGroup>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>

                <!--
                    指针：指向右上方约 45 度。
                    用「粗描边 + 圆头」而不是细四边形，否则缩到 16px 后
                    只剩一根一像素的线，几乎看不出是表针。
                -->
                <GeometryDrawing Brush="Transparent">
                    <GeometryDrawing.Pen>
                        <Pen Brush="#FFFF6B4A" Thickness="56" StartLineCap="Round" EndLineCap="Round" />
                    </GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <PathGeometry Figures="M512 512L648 376" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>

                <!--  中心轴：深色底 + 白色高光点  -->
                <GeometryDrawing Brush="#FF3D4265">
                    <GeometryDrawing.Geometry>
                        <PathGeometry Figures="M512 432A80 80 0 1 0 512 592A80 80 0 1 0 512 432Z" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing Brush="#FFFFFFFF">
                    <GeometryDrawing.Geometry>
                        <PathGeometry Figures="M512 478A34 34 0 1 0 512 546A34 34 0 1 0 512 478Z" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <!-- =====  内存：内存条  =====  -->
    <DrawingImage x:Key="GaugeIcon_memory">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <!--  条体  -->
                <GeometryDrawing Brush="#FF3D4265">
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="112,304,800,320" RadiusX="48" RadiusY="48" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <!--  条体内的亮面，形成「插槽」感  -->
                <GeometryDrawing Brush="#FF7094F3">
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="160,352,704,112" RadiusX="24" RadiusY="24" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <!--  内存颗粒 + 高光  -->
                <GeometryDrawing Brush="#FFEEF1F8">
                    <GeometryDrawing.Geometry>
                        <GeometryGroup>
                            <RectangleGeometry Rect="160,504,128,96" RadiusX="16" RadiusY="16" />
                            <RectangleGeometry Rect="328,504,128,96" RadiusX="16" RadiusY="16" />
                            <RectangleGeometry Rect="496,504,128,96" RadiusX="16" RadiusY="16" />
                            <RectangleGeometry Rect="664,504,128,96" RadiusX="16" RadiusY="16" />
                        </GeometryGroup>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <!--  底部金手指  -->
                <GeometryDrawing Brush="#FFFFC94D">
                    <GeometryDrawing.Geometry>
                        <GeometryGroup>
                            <RectangleGeometry Rect="176,624,64,56" RadiusX="10" RadiusY="10" />
                            <RectangleGeometry Rect="288,624,64,56" RadiusX="10" RadiusY="10" />
                            <RectangleGeometry Rect="400,624,64,56" RadiusX="10" RadiusY="10" />
                            <RectangleGeometry Rect="512,624,64,56" RadiusX="10" RadiusY="10" />
                            <RectangleGeometry Rect="624,624,64,56" RadiusX="10" RadiusY="10" />
                            <RectangleGeometry Rect="736,624,64,56" RadiusX="10" RadiusY="10" />
                        </GeometryGroup>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <!--  顶部缺口，强化「内存条」识别度  -->
                <GeometryDrawing Brush="#FFEEF1F8">
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="448,264,128,64" RadiusX="16" RadiusY="16" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <!-- =====  网络：上下双向箭头  =====  -->
    <DrawingImage x:Key="GaugeIcon_network">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <!--
                    下行箭头（左，绿色）与上行箭头（右，蓝色）。

                    每个箭头由「矩形杆 + 三角形头」两部分组成，而不是把杆和头
                    画成一个闭合 Path —— 后者在 WPF 里会把折返点连成空心的
                    锯齿轮廓，缩小到 16px 就成了断开的三角形。
                -->
                <GeometryDrawing Brush="#FF3DD68C">
                    <GeometryDrawing.Geometry>
                        <GeometryGroup>
                            <!--  杆  -->
                            <RectangleGeometry Rect="256,152,128,480" RadiusX="64" RadiusY="64" />
                            <!--  头  -->
                            <PathGeometry Figures="M320 880L112 616L528 616Z" />
                        </GeometryGroup>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>

                <GeometryDrawing Brush="#FF7094F3">
                    <GeometryDrawing.Geometry>
                        <GeometryGroup>
                            <RectangleGeometry Rect="640,392,128,480" RadiusX="64" RadiusY="64" />
                            <PathGeometry Figures="M704 152L512 416L896 416Z" />
                        </GeometryGroup>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <!-- =====  音量：喇叭 + 声波  =====  -->
    <DrawingImage x:Key="GaugeIcon_volume">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <!--
                    喇叭朝右：左侧矩形是机身，右侧梯形是喇叭口。
                    拆成两个实心几何而不是一个折返 Path —— 理由同网络箭头。
                -->
                <GeometryDrawing Brush="#FF3D4265">
                    <GeometryDrawing.Geometry>
                        <GeometryGroup>
                            <RectangleGeometry Rect="112,400,192,224" RadiusX="32" RadiusY="32" />
                            <PathGeometry Figures="M304 400L560 208L560 816L304 624Z" />
                        </GeometryGroup>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>

                <!--  喇叭口亮面，做体积  -->
                <GeometryDrawing Brush="#FF7094F3">
                    <GeometryDrawing.Geometry>
                        <PathGeometry Figures="M304 448L512 288L512 736L304 576Z" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>

                <!--
                    两道声波：用「粗圆弧描边」实现，而不是填充的折返 Path。
                    填充折返 Path 在 WPF 里会把内弧和外弧之间连成一条锯齿，
                    缩到 16px 就只剩几段碎线。
                -->
                <GeometryDrawing Brush="Transparent">
                    <GeometryDrawing.Pen>
                        <Pen Brush="#FFFFC94D" Thickness="72" StartLineCap="Round" EndLineCap="Round" />
                    </GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <PathGeometry Figures="M632 368A200 200 0 0 1 632 656" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>

                <GeometryDrawing Brush="Transparent">
                    <GeometryDrawing.Pen>
                        <Pen Brush="#FFFF9F0A" Thickness="72" StartLineCap="Round" EndLineCap="Round" />
                    </GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <PathGeometry Figures="M760 264A336 336 0 0 1 760 760" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

</ResourceDictionary>
