<Window x:Class="MyTopBar.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MyTopBar Settings"
        Width="560"
        Height="720"
        Background="{DynamicResource MenuBackgroundBrush}"
        Foreground="{DynamicResource MenuForegroundBrush}"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <!--  设置窗口里重复出现的小标题 / 标签，统一收口  -->
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource AppFontMedium}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="{DynamicResource MenuForegroundBrush}" />
            <Setter Property="Margin" Value="0,14,0,8" />
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Width" Value="110" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{DynamicResource MenuForegroundBrush}" />
        </Style>

        <Style x:Key="HintText" TargetType="TextBlock">
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{DynamicResource MenuSecondaryForegroundBrush}" />
        </Style>
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20,16,20,20">
            <TextBlock FontFamily="{StaticResource AppFontMedium}"
                       FontSize="18"
                       Foreground="{DynamicResource MenuForegroundBrush}"
                       Text="设置" />

            <!--  ==========  外观  ==========  -->
            <TextBlock Style="{StaticResource SectionHeader}" Text="外观" />

            <StackPanel Margin="0,0,0,8" Orientation="Horizontal">
                <TextBlock Style="{StaticResource FieldLabel}" Text="材质" />
                <ComboBox Width="300"
                          ItemsSource="{Binding Materials}"
                          SelectedItem="{Binding Material, Mode=TwoWay}"
                          Style="{StaticResource SettingsComboBox}" />
            </StackPanel>

            <StackPanel Margin="0,0,0,8" Orientation="Horizontal">
                <TextBlock Style="{StaticResource FieldLabel}" Text="主题" />
                <ComboBox Width="180"
                          ItemsSource="{Binding ThemeModes}"
                          SelectedItem="{Binding SelectedTheme, Mode=TwoWay}"
                          Style="{StaticResource SettingsComboBox}" />
            </StackPanel>

            <StackPanel Margin="0,0,0,16" Orientation="Horizontal">
                <TextBlock Style="{StaticResource FieldLabel}" Text="顶栏高度" />
                <Slider Width="180"
                        VerticalAlignment="Center"
                        IsSnapToTickEnabled="True"
                        Maximum="40"
                        Minimum="28"
                        Style="{StaticResource SettingsSlider}"
                        TickFrequency="1"
                        Value="{Binding BarHeight, Mode=TwoWay}" />
                <TextBlock Style="{StaticResource HintText}" Text="{Binding BarHeight, StringFormat={}{0:0}px}" />
            </StackPanel>

            <!--  ==========  组件  ==========  -->
            <TextBlock Style="{StaticResource SectionHeader}" Text="组件" />

            <ItemsControl ItemsSource="{Binding Widgets}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <CheckBox Margin="2,0,0,6"
                                  Content="{Binding DisplayName}"
                                  IsChecked="{Binding IsEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  Style="{StaticResource SettingsCheckBox}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!--  ==========  和风天气  ==========  -->
            <TextBlock Style="{StaticResource SectionHeader}" Text="和风天气" />

            <!--  说明块：写清楚要填什么、去哪里拿  -->
            <Border Margin="0,0,0,10"
                    Padding="10,8"
                    Background="{DynamicResource InputBackgroundBrush}"
                    BorderBrush="{DynamicResource InputBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="6">
                <StackPanel>
                    <TextBlock Foreground="{DynamicResource MenuSecondaryForegroundBrush}"
                               Style="{StaticResource HintText}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,6"
                               Text="使用新版 API（/weather/v1/current）与请求头认证。旧的 devapi.qweather.com 公共域名已列入停用计划，不再使用。" />

                    <TextBlock Foreground="{DynamicResource MenuSecondaryForegroundBrush}"
                               Style="{StaticResource HintText}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,2"
                               Text="1. API Host：控制台 → 设置 → API Host，形如 h2a9cf3mhs.xy.qweatherapi.com（每账号独立，不可猜测）" />

                    <TextBlock Foreground="{DynamicResource MenuSecondaryForegroundBrush}"
                               Style="{StaticResource HintText}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,2"
                               Text="2. API Key：控制台 → 项目管理 → 凭据 → 创建凭据，认证方式选 API KEY" />

                    <TextBlock Foreground="{DynamicResource MenuSecondaryForegroundBrush}"
                               Style="{StaticResource HintText}"
                               TextWrapping="Wrap"
                               Text="3. 经纬度：新版按经纬度定位（旧版是城市 ID）。北京 39.92 / 116.41，最多两位小数。" />
                </StackPanel>
            </Border>

            <StackPanel Margin="0,0,0,8" Orientation="Horizontal">
                <TextBlock Style="{StaticResource FieldLabel}" Text="API Host" />
                <TextBox Width="300"
                         Style="{StaticResource SettingsTextBox}"
                         Text="{Binding QweatherApiHost, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>

            <StackPanel Margin="0,0,0,8" Orientation="Horizontal">
                <TextBlock Style="{StaticResource FieldLabel}" Text="API Key" />
                <TextBox Width="300"
                         Style="{StaticResource SettingsTextBox}"
                         Text="{Binding QweatherApiKey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>

            <!--  ==========  地点（GeoAPI 城市搜索）  ==========  -->
            <StackPanel Margin="0,0,0,6" Orientation="Horizontal">
                <TextBlock Style="{StaticResource FieldLabel}" Text="地点" />
                <TextBox Width="220"
                         Style="{StaticResource SettingsTextBox}"
                         Text="{Binding QweatherSearchKeyword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                    <TextBox.InputBindings>
                        <!--  回车即搜索  -->
                        <KeyBinding Key="Return" Command="{Binding SearchCityCommand}" />
                    </TextBox.InputBindings>
                </TextBox>
                <Button Margin="8,0,0,0"
                        Padding="12,5"
                        Command="{Binding SearchCityCommand}"
                        Content="搜索"
                        Cursor="Hand"
                        FontFamily="{StaticResource AppFont}"
                        FontSize="13" />
            </StackPanel>

            <!--  搜索结果；有结果时才显示，避免占位  -->
            <ListBox x:Name="CityList"
                     MaxHeight="150"
                     Margin="0,0,0,6"
                     DisplayMemberPath="Display"
                     ItemsSource="{Binding QweatherSearchResults}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     SelectionChanged="OnCitySelectionChanged">
                <ListBox.Style>
                    <Style TargetType="ListBox">
                        <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}" />
                        <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}" />
                        <Setter Property="BorderThickness" Value="1" />
                        <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
                        <Setter Property="FontSize" Value="13" />
                        <Setter Property="Foreground" Value="{DynamicResource InputForegroundBrush}" />
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <!--  没有搜索结果时不占位  -->
                            <DataTrigger Binding="{Binding QweatherSearchResults.Count}" Value="0">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ListBox.Style>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="8,4" />
                        <Setter Property="Foreground" Value="{DynamicResource InputForegroundBrush}" />
                    </Style>
                </ListBox.ItemContainerStyle>
            </ListBox>

            <!--  当前选中的地点 + 坐标只读展示  -->
            <StackPanel Margin="0,0,0,8" Orientation="Horizontal">
                <TextBlock Style="{StaticResource FieldLabel}" Text="当前地点" />
                <TextBlock VerticalAlignment="Center"
                           Foreground="{DynamicResource MenuSecondaryForegroundBrush}"
                           FontFamily="{StaticResource AppFont}"
                           FontSize="13"
                           Text="{Binding QweatherSelectedPlace}" />
            </StackPanel>

            <TextBlock Margin="112,0,0,8"
                       Foreground="{DynamicResource MenuSecondaryForegroundBrush}"
                       FontFamily="{StaticResource AppFont}"
                       FontSize="12"
                       TextWrapping="Wrap"
                       Text="{Binding QweatherSearchStatus}" />

            <!--  经纬度仍保留，供手动微调或直接填坐标  -->
            <StackPanel Margin="0,0,0,8" Orientation="Horizontal">
                <TextBlock Style="{StaticResource FieldLabel}" Text="经纬度（自动填入）" />
                <TextBox Width="80"
                         Style="{StaticResource SettingsTextBox}"
                         Text="{Binding QweatherLatitude, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Style="{StaticResource HintText}" Text="/" />
                <TextBox Width="80"
                         Margin="8,0,0,0"
                         Style="{StaticResource SettingsTextBox}"
                         Text="{Binding QweatherLongitude, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>

            <StackPanel Margin="0,0,0,10" Orientation="Horizontal">
                <TextBlock Style="{StaticResource FieldLabel}" Text="刷新间隔" />
                <Slider Width="180"
                        VerticalAlignment="Center"
                        IsSnapToTickEnabled="True"
                        Maximum="240"
                        Minimum="5"
                        Style="{StaticResource SettingsSlider}"
                        TickFrequency="5"
                        Value="{Binding QweatherIntervalMinutes, Mode=TwoWay}" />
                <TextBlock Style="{StaticResource HintText}" Text="{Binding QweatherIntervalMinutes, StringFormat={}{0:0} 分钟}" />
            </StackPanel>

            <!--
                应用按钮：参数改完后点击才提交并请求，
                避免每敲一个字就发一次请求，也让用户能确认结果。
            -->
            <StackPanel Margin="0,2,0,6" Orientation="Horizontal">
                <Button MinWidth="96"
                        Padding="14,6"
                        Command="{Binding ApplyQWeatherCommand}"
                        Content="应用并测试"
                        FontFamily="{StaticResource AppFont}"
                        FontSize="13"
                        Cursor="Hand">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource AccentForegroundBrush}" />
                            <Setter Property="BorderThickness" Value="0" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Root"
                                                Padding="{TemplateBinding Padding}"
                                                Background="{TemplateBinding Background}"
                                                CornerRadius="5">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Root" Property="Opacity" Value="0.88" />
                                            </Trigger>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter TargetName="Root" Property="Opacity" Value="0.45" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <!--  没有改动时按钮置灰，暗示"当前已是生效状态"  -->
                                <DataTrigger Binding="{Binding HasPendingQWeatherChanges}" Value="False">
                                    <Setter Property="IsEnabled" Value="False" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <!--  改动未提交的提示  -->
                <TextBlock Margin="10,0,0,0"
                           VerticalAlignment="Center"
                           Text="参数已修改，点左侧按钮生效">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource HintText}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasPendingQWeatherChanges}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>

            <!--  请求结果：成功绿色，失败红色  -->
            <TextBlock Margin="2,0,0,14" TextWrapping="Wrap" Text="{Binding QweatherStatus}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource HintText}">
                        <Setter Property="Foreground" Value="{DynamicResource MenuSecondaryForegroundBrush}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding QweatherStatusIsError}" Value="True">
                                <Setter Property="Foreground" Value="#E05252" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding QweatherStatusIsError}" Value="False">
                                <Setter Property="Foreground" Value="#3FA45B" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding QweatherStatus}" Value="">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <!--  未配置完整时的提示；配好了就自动隐藏  -->
            <TextBlock Foreground="{DynamicResource MenuSecondaryForegroundBrush}"
                       Margin="2,0,0,14"
                       Text="※ 以上三项填齐后点「应用并测试」，顶栏才会显示天气。">
                <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource HintText}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsQWeatherConfigured}" Value="False">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <!--  ==========  歌词  ==========  -->
            <TextBlock Style="{StaticResource SectionHeader}" Text="歌词" />

            <Border Margin="0,0,0,10"
                    Padding="10,8"
                    Background="{DynamicResource InputBackgroundBrush}"
                    BorderBrush="{DynamicResource InputBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="6">
                <StackPanel>
                    <TextBlock Foreground="{DynamicResource MenuSecondaryForegroundBrush}"
                               Style="{StaticResource HintText}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,0"
                               Text="同时开着浏览器和音乐播放器时，系统会跟随最后发声的那个，歌词可能跳到网页上正在播的内容。指定来源后只读取该应用的媒体信息。" />
                </StackPanel>
            </Border>

            <StackPanel Margin="0,0,0,8" Orientation="Horizontal">
                <TextBlock Style="{StaticResource FieldLabel}" Text="媒体来源" />
                <ComboBox Width="300"
                          DisplayMemberPath="Display"
                          ItemsSource="{Binding MediaSources}"
                          SelectedItem="{Binding SelectedMediaSource, Mode=TwoWay}"
                          Style="{StaticResource SettingsComboBox}" />
            </StackPanel>

            <TextBlock Margin="112,0,0,14"
                       Foreground="{DynamicResource MenuSecondaryForegroundBrush}"
                       FontFamily="{StaticResource AppFont}"
                       FontSize="12"
                       TextWrapping="Wrap"
                       Text="列表里只显示当前正在播放的来源；关掉播放器后该项仍会保留，不会丢失配置。" />

            <!--  ==========  其他  ==========  -->
            <TextBlock Style="{StaticResource SectionHeader}" Text="其他" />

            <CheckBox Margin="2,0,0,0"
                      Content="启用一言（Text 组件使用一言 API）"
                      IsChecked="{Binding HitokotoEnabled, Mode=TwoWay}"
                      Style="{StaticResource SettingsCheckBox}" />
        </StackPanel>
    </ScrollViewer>
</Window>
