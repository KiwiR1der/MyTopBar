<Window x:Class="MyTopBar.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MyTopBar Settings"
        Width="540" Height="600"
        Background="{DynamicResource MenuBackgroundBrush}"
        WindowStartupLocation="CenterScreen">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20">
            <TextBlock Text="设置" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,14" />

            <TextBlock Text="外观" FontWeight="SemiBold" Margin="0,6,0,8" />

            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <TextBlock Text="材质" Width="110" VerticalAlignment="Center" />
                <ComboBox Width="300"
                          ItemsSource="{Binding Materials}"
                          SelectedItem="{Binding Material, Mode=TwoWay}" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <TextBlock Text="主题" Width="110" VerticalAlignment="Center" />
                <ComboBox Width="180"
                          ItemsSource="{Binding ThemeModes}"
                          SelectedItem="{Binding SelectedTheme, Mode=TwoWay}" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                <TextBlock Text="顶栏高度" Width="110" VerticalAlignment="Center" />
                <Slider Width="180"
                        Maximum="40"
                        Minimum="28"
                        IsSnapToTickEnabled="True"
                        TickFrequency="1"
                        VerticalAlignment="Center"
                        Value="{Binding BarHeight, Mode=TwoWay}" />
                <TextBlock Margin="8,0,0,0"
                           VerticalAlignment="Center"
                           Text="{Binding BarHeight, StringFormat={}{0:0}px}" />
            </StackPanel>

            <TextBlock Text="组件" FontWeight="SemiBold" Margin="0,6,0,8" />

            <ItemsControl ItemsSource="{Binding Widgets}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <CheckBox Margin="0,0,0,4"
                                  Content="{Binding DisplayName}"
                                  IsChecked="{Binding IsEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Text="API" FontWeight="SemiBold" Margin="0,14,0,8" />

            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <TextBlock Text="QWeather Key" Width="110" VerticalAlignment="Center" />
                <TextBox Width="240" Text="{Binding QweatherKey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>

            <CheckBox Content="Enable Hitokoto"
                      IsChecked="{Binding HitokotoEnabled, Mode=TwoWay}" />
        </StackPanel>
    </ScrollViewer>
</Window>