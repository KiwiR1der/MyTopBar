<Window x:Class="MyTopBar.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MyTopBar Settings"
        Width="560"
        Height="720"
        Background="{DynamicResource MenuBackgroundBrush}"
        Foreground="{DynamicResource MenuForegroundBrush}"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <!--  设置窗口里重复出现的小标题 / 标签，统一收口  -->
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource AppFontMedium}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="{DynamicResource MenuForegroundBrush}" />
            <Setter Property="Margin" Value="0,14,0,8" />
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Width" Value="110" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{DynamicResource MenuForegroundBrush}" />
        </Style>

        <Style x:Key="HintText" TargetType="TextBlock">
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{DynamicResource MenuSecondaryForegroundBrush}" />
        </Style>
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20,16,20,20">
            <TextBlock FontFamily="{StaticResource AppFontMedium}"
                       FontSize="18"
                       Foreground="{DynamicResource MenuForegroundBrush}"
                       Text="设置" />

            <!--  ==========  外观  ==========  -->
            <TextBlock Style="{StaticResource SectionHeader}" Text="外观" />

            <StackPanel Margin="0,0,0,8" Orientation="Horizontal">
                <TextBlock Style="{StaticResource FieldLabel}" Text="材质" />
                <ComboBox Width="300"
                          ItemsSource="{Binding Materials}"
                          SelectedItem="{Binding Material, Mode=TwoWay}"
                          Style="{StaticResource SettingsComboBox}" />
            </StackPanel>

            <StackPanel Margin="0,0,0,8" Orientation="Horizontal">
                <TextBlock Style="{StaticResource FieldLabel}" Text="主题" />
                <ComboBox Width="180"
                          ItemsSource="{Binding ThemeModes}"
                          SelectedItem="{Binding SelectedTheme, Mode=TwoWay}"
                          Style="{StaticResource SettingsComboBox}" />
            </StackPanel>

            <StackPanel Margin="0,0,0,16" Orientation="Horizontal">
                <TextBlock Style="{StaticResource FieldLabel}" Text="顶栏高度" />
                <Slider Width="180"
                        VerticalAlignment="Center"
                        IsSnapToTickEnabled="True"
                        Maximum="40"
                        Minimum="28"
                        Style="{StaticResource SettingsSlider}"
                        TickFrequency="1"
                        Value="{Binding BarHeight, Mode=TwoWay}" />
                <TextBlock Style="{StaticResource HintText}" Text="{Binding BarHeight, StringFormat={}{0:0}px}" />
            </StackPanel>

            <!--  ==========  组件  ==========  -->
            <TextBlock Style="{StaticResource SectionHeader}" Text="组件" />

            <ItemsControl ItemsSource="{Binding Widgets}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <CheckBox Margin="2,0,0,6"
                                  Content="{Binding DisplayName}"
                                  IsChecked="{Binding IsEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  Style="{StaticResource SettingsCheckBox}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!--  ==========  和风天气  ==========  -->
            <TextBlock Style="{StaticResource SectionHeader}" Text="和风天气" />

            <!--  说明块：写清楚要填什么、去哪里拿  -->
            <Border Margin="0,0,0,10"
                    Padding="10,8"
                    Background="{DynamicResource InputBackgroundBrush}"
                    BorderBrush="{DynamicResource InputBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="6">
                <StackPanel>
                    <TextBlock Foreground="{DynamicResource MenuSecondaryForegroundBrush}"
                               Style="{StaticResource HintText}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,6"
                               Text="使用新版 API（/weather/v1/current）与请求头认证。旧的 devapi.qweather.com 公共域名已列入停用计划，不再使用。" />

                    <TextBlock Foreground="{DynamicResource MenuSecondaryForegroundBrush}"
                               Style="{StaticResource HintText}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,2"
                               Text="1. API Host：控制台 → 设置 → API Host，形如 h2a9cf3mhs.xy.qweatherapi.com（每账号独立，不可猜测）" />

                    <TextBlock Foreground="{DynamicResource MenuSecondaryForegroundBrush}"
                               Style="{StaticResource HintText}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,2"
                               Text="2. API Key：控制台 → 项目管理 → 凭据 → 创建凭据，认证方式选 API KEY" />

                    <TextBlock Foreground="{DynamicResource MenuSecondaryForegroundBrush}"
                               Style="{StaticResource HintText}"
                               TextWrapping="Wrap"
                               Text="3. 经纬度：新版按经纬度定位（旧版是城市 ID）。北京 39.92 / 116.41，最多两位小数。" />
                </StackPanel>
            </Border>

            <StackPanel Margin="0,0,0,8" Orientation="Horizontal">
                <TextBlock Style="{StaticResource FieldLabel}" Text="API Host" />
                <TextBox Width="300"
                         Style="{StaticResource SettingsTextBox}"
                         Text="{Binding QweatherApiHost, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>

            <StackPanel Margin="0,0,0,8" Orientation="Horizontal">
                <TextBlock Style="{StaticResource FieldLabel}" Text="API Key" />
                <TextBox Width="300"
                         Style="{StaticResource SettingsTextBox}"
                         Text="{Binding QweatherApiKey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>

            <StackPanel Margin="0,0,0,8" Orientation="Horizontal">
                <TextBlock Style="{StaticResource FieldLabel}" Text="纬度 / 经度" />
                <TextBox Width="90"
                         Style="{StaticResource SettingsTextBox}"
                         Text="{Binding QweatherLatitude, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Style="{StaticResource HintText}" Text="/" />
                <TextBox Width="90"
                         Margin="8,0,0,0"
                         Style="{StaticResource SettingsTextBox}"
                         Text="{Binding QweatherLongitude, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>

            <StackPanel Margin="0,0,0,10" Orientation="Horizontal">
                <TextBlock Style="{StaticResource FieldLabel}" Text="刷新间隔" />
                <Slider Width="180"
                        VerticalAlignment="Center"
                        IsSnapToTickEnabled="True"
                        Maximum="240"
                        Minimum="5"
                        Style="{StaticResource SettingsSlider}"
                        TickFrequency="5"
                        Value="{Binding QweatherIntervalMinutes, Mode=TwoWay}" />
                <TextBlock Style="{StaticResource HintText}" Text="{Binding QweatherIntervalMinutes, StringFormat={}{0:0} 分钟}" />
            </StackPanel>

            <!--  未配置完整时的提示；配好了就自动隐藏  -->
            <TextBlock Foreground="{DynamicResource MenuSecondaryForegroundBrush}"
                       Margin="2,0,0,14"
                       Text="※ 以上三项填齐后天气才会显示，否则顶栏显示「天气 未配置」。">
                <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource HintText}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsQWeatherConfigured}" Value="False">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <!--  ==========  其他  ==========  -->
            <TextBlock Style="{StaticResource SectionHeader}" Text="其他" />

            <CheckBox Margin="2,0,0,0"
                      Content="启用一言（Text 组件使用一言 API）"
                      IsChecked="{Binding HitokotoEnabled, Mode=TwoWay}"
                      Style="{StaticResource SettingsCheckBox}" />
        </StackPanel>
    </ScrollViewer>
</Window>
