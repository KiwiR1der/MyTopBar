<UserControl x:Class="MyTopBar.Views.WeatherPopupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:common="clr-namespace:MyTopBar.Infrastructure.Common"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DesignHeight="400"
             d:DesignWidth="300"
             mc:Ignorable="d">
    <UserControl.Resources>
        <common:WeatherIconConverter x:Key="WeatherIconConverter" />
    </UserControl.Resources>
    <StackPanel>

        <!--  顶部：地点 + 天气标签  -->
        <Grid Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock VerticalAlignment="Center"
                       FontFamily="{StaticResource AppFont}"
                       FontWeight="{StaticResource FontWeightEmphasis}"
                       FontSize="14"
                       Foreground="{DynamicResource MenuForegroundBrush}"
                       Text="{Binding PlaceName}" />

            <Border Grid.Column="1"
                    Padding="10,4"
                    Background="{DynamicResource MenuHoverBrush}"
                    CornerRadius="12">
                <TextBlock FontSize="11"
                           FontWeight="{StaticResource FontWeightEmphasis}"
                           Foreground="{DynamicResource MenuSecondaryForegroundBrush}"
                           Text="{Binding ConditionText, StringFormat=现在 · {0}}" />
            </Border>
        </Grid>

        <!--  大温度 + 图标  -->
        <Grid Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock VerticalAlignment="Bottom"
                       FontFamily="{StaticResource AppFont}"
                       FontSize="64"
                       FontWeight="{StaticResource FontWeightCaption}"
                       Foreground="{DynamicResource MenuForegroundBrush}"
                       Text="{Binding Temperature, StringFormat={}{0}°}" />

            <Image Grid.Column="1"
                   Width="52"
                   Height="52"
                   VerticalAlignment="Bottom"
                   Margin="8,0,0,4"
                   Source="{Binding Icon, Converter={StaticResource WeatherIconConverter}}" />
        </Grid>

        <!--  最高 / 最低  -->
        <TextBlock Margin="0,0,0,14"
                   FontSize="13"
                   FontWeight="{StaticResource FontWeightEmphasis}"
                   Foreground="{DynamicResource MenuSecondaryForegroundBrush}">
            <Run Text="最高 " />
            <Run Text="{Binding HighTemp}" />
            <Run Text=" · 最低 " />
            <Run Text="{Binding LowTemp}" />
        </TextBlock>

        <!--  分隔线  -->
        <Separator Margin="0,0,0,12" Style="{StaticResource AppleMenuSeparator}" />

        <!--  详情指标：2 列 × 2 行  -->
        <Grid Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!--  体感温度  -->
            <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,8,8">
                <TextBlock FontSize="11"
                           Foreground="{DynamicResource MenuSecondaryForegroundBrush}"
                           Text="体感温度" />
                <TextBlock Margin="0,2,0,0"
                           FontSize="17"
                           FontWeight="{StaticResource FontWeightEmphasis}"
                           Foreground="{DynamicResource MenuForegroundBrush}"
                           Text="{Binding FeelsLike}" />
            </StackPanel>

            <!--  湿度  -->
            <StackPanel Grid.Row="0" Grid.Column="1" Margin="8,0,0,8">
                <TextBlock FontSize="11"
                           Foreground="{DynamicResource MenuSecondaryForegroundBrush}"
                           Text="湿度" />
                <TextBlock Margin="0,2,0,0"
                           FontSize="17"
                           FontWeight="{StaticResource FontWeightEmphasis}"
                           Foreground="{DynamicResource MenuForegroundBrush}"
                           Text="{Binding Humidity}" />
            </StackPanel>

            <!--  风速  -->
            <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,8,0">
                <TextBlock FontSize="11"
                           Foreground="{DynamicResource MenuSecondaryForegroundBrush}"
                           Text="风速" />
                <TextBlock Margin="0,2,0,0"
                           FontSize="17"
                           FontWeight="{StaticResource FontWeightEmphasis}"
                           Foreground="{DynamicResource MenuForegroundBrush}"
                           Text="{Binding WindInfo}" />
            </StackPanel>

            <!--  日出日落  -->
            <StackPanel Grid.Row="1" Grid.Column="1" Margin="8,0,0,0">
                <TextBlock FontSize="11"
                           Foreground="{DynamicResource MenuSecondaryForegroundBrush}"
                           Text="日出 / 日落" />
                <TextBlock Margin="0,2,0,0"
                           FontSize="17"
                           FontWeight="{StaticResource FontWeightEmphasis}"
                           Foreground="{DynamicResource MenuForegroundBrush}">
                    <Run Text="{Binding Sunrise}" />
                    <Run Text=" / " />
                    <Run Text="{Binding Sunset}" />
                </TextBlock>
            </StackPanel>
        </Grid>

        <!--  未来预报标题  -->
        <TextBlock Margin="0,0,0,8"
                   FontSize="12"
                   FontWeight="{StaticResource FontWeightHeading}"
                   Foreground="{DynamicResource MenuSecondaryForegroundBrush}"
                   Text="未来预报" />

        <!--  预报行  -->
        <ItemsControl ItemsSource="{Binding Forecasts}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="44" />
                            <ColumnDefinition Width="28" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   VerticalAlignment="Center"
                                   FontSize="13"
                                   Foreground="{DynamicResource MenuForegroundBrush}"
                                   Text="{Binding DayName}" />

                        <Image Grid.Column="1"
                               Width="18"
                               Height="18"
                               VerticalAlignment="Center"
                               Source="{Binding Icon, Converter={StaticResource WeatherIconConverter}}" />

                        <TextBlock Grid.Column="2"
                                   VerticalAlignment="Center"
                                   Margin="6,0,0,0"
                                   FontSize="13"
                                   Foreground="{DynamicResource MenuSecondaryForegroundBrush}"
                                   Text="{Binding Condition}" />

                        <StackPanel Grid.Column="3"
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal">
                            <TextBlock FontSize="13"
                                       FontWeight="{StaticResource FontWeightEmphasis}"
                                       Foreground="{DynamicResource MenuForegroundBrush}"
                                       Text="{Binding High}" />
                            <TextBlock Margin="4,0,0,0"
                                       FontSize="13"
                                       Foreground="{DynamicResource MenuSecondaryForegroundBrush}"
                                       Text="{Binding Low}" />
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

    </StackPanel>
</UserControl>
