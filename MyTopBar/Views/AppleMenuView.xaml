<UserControl
    d:DesignHeight="300"
    d:DesignWidth="220"
    mc:Ignorable="d"
    x:Class="MyTopBar.Views.AppleMenuView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        Apple 菜单的内容。
        外层的毛玻璃边框由 PopupWindow 统一提供，这里只放菜单项本身。
    -->
    <StackPanel Width="220">
        <Button
            Command="{Binding AboutThisPcCommand}"
            Content="关于本机"
            Style="{StaticResource AppleMenuItem}" />
        <Button
            Command="{Binding OpenSettingsCommand}"
            Content="系统设置"
            Style="{StaticResource AppleMenuItem}" />
        <Button
            Command="{Binding OpenBarSettingsCommand}"
            Content="MyTopBar 设置…"
            Style="{StaticResource AppleMenuItem}" />
        <Separator Style="{StaticResource AppleMenuSeparator}" />
        <Button
            Command="{Binding SleepCommand}"
            Content="睡眠"
            Style="{StaticResource AppleMenuItem}" />
        <Button
            Command="{Binding RestartCommand}"
            Content="重新启动…"
            Style="{StaticResource AppleMenuItem}" />
        <Button
            Command="{Binding ShutdownCommand}"
            Content="关机…"
            Style="{StaticResource AppleMenuItem}" />
        <Separator Style="{StaticResource AppleMenuSeparator}" />
        <Button
            Command="{Binding ExitCommand}"
            Content="退出 MyTopBar"
            Style="{StaticResource AppleMenuItem}" />
    </StackPanel>
</UserControl>
