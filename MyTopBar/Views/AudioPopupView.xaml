<UserControl x:Class="MyTopBar.Views.AudioPopupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:MyTopBar.Views"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DesignHeight="450"
             d:DesignWidth="800"
             mc:Ignorable="d">
    <Grid>
        <StackPanel Orientation="Horizontal">
            <TextBlock Foreground="{DynamicResource MenuSecondaryForegroundBrush}" Text="Audio: " />
            <Slider Width="200"
                    Maximum="1"
                    Minimum="0"
                    Style="{StaticResource SettingsSlider}"
                    Value="{Binding Volume, Mode=TwoWay}" />
        </StackPanel>
    </Grid>
</UserControl>
