<UserControl x:Class="MyTopBar.Views.SystemDetailPopupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DesignHeight="260"
             d:DesignWidth="280"
             mc:Ignorable="d">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    </UserControl.Resources>
    <StackPanel>

        <!--  标题 + 大数值  -->
        <TextBlock Margin="0,0,0,10"
                   FontFamily="{StaticResource AppFont}"
                   FontWeight="{StaticResource FontWeightEmphasis}"
                   FontSize="14"
                   Foreground="{DynamicResource MenuForegroundBrush}"
                   Text="{Binding Title}" />

        <TextBlock FontFamily="{StaticResource AppFont}"
                   FontSize="44"
                   FontWeight="{StaticResource FontWeightBody}"
                   Foreground="{DynamicResource MenuForegroundBrush}"
                   Text="{Binding Headline}" />

        <TextBlock Margin="0,4,0,14"
                   FontSize="12"
                   Foreground="{DynamicResource MenuSecondaryForegroundBrush}"
                   Text="{Binding Subtitle}"
                   TextWrapping="Wrap" />

        <Separator Margin="0,0,0,10" Style="{StaticResource AppleMenuSeparator}" />

        <!--  进程占用 Top5  -->
        <Grid Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock FontSize="12"
                       FontWeight="{StaticResource FontWeightEmphasis}"
                       Foreground="{DynamicResource MenuSecondaryForegroundBrush}"
                       Text="占用最高的进程" />
            <TextBlock Grid.Column="1"
                       FontSize="11"
                       Foreground="{DynamicResource MenuSecondaryForegroundBrush}"
                       Text="采集中…"
                       Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}" />
        </Grid>

        <ItemsControl ItemsSource="{Binding Processes}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="0,3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock FontSize="12"
                                   Foreground="{DynamicResource MenuForegroundBrush}"
                                   Text="{Binding Name}"
                                   TextTrimming="CharacterEllipsis" />

                        <TextBlock Grid.Column="1"
                                   Margin="8,0,0,0"
                                   FontSize="12"
                                   FontWeight="{StaticResource FontWeightEmphasis}"
                                   Foreground="{DynamicResource MenuForegroundBrush}"
                                   Text="{Binding Display}" />
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TextBlock Margin="0,10,0,0"
                   FontSize="11"
                   Foreground="{DynamicResource MenuSecondaryForegroundBrush}"
                   Text="打开弹窗时采样一次，关闭后不再统计"
                   TextWrapping="Wrap" />

    </StackPanel>
</UserControl>
