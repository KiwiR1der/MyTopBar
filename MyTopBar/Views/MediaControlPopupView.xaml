<UserControl x:Class="MyTopBar.Views.MediaControlPopupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DesignHeight="200"
             d:DesignWidth="280"
             mc:Ignorable="d">
    <UserControl.Resources>
        <!--  播放控制按钮：圆形、悬停高亮、无边框  -->
        <Style x:Key="TransportButton" TargetType="Button">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="34" />
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource MenuForegroundBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                CornerRadius="17">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource MenuItemHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Opacity" Value="0.7" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.35" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  主按钮（播放/暂停）：略大，带淡色底  -->
        <Style x:Key="PrimaryTransportButton"
               BasedOn="{StaticResource TransportButton}"
               TargetType="Button">
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="40" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Background" Value="{DynamicResource PopupGlassBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                CornerRadius="20">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Opacity" Value="0.75" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <StackPanel Width="252">

        <!--  =====  曲目信息：封面 + 标题/歌手  =====  -->
        <Grid Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!--  封面：无图时露出占位底色  -->
            <Border Width="56"
                    Height="56"
                    Background="{DynamicResource PopupGlassBrush}"
                    BorderBrush="{DynamicResource InputBorderBrush}"
                    BorderThickness="1"
                    ClipToBounds="True"
                    CornerRadius="6">
                <Grid>
                    <Image Stretch="UniformToFill" Source="{Binding Artwork}" />
                    <!--  无封面时的音符占位  -->
                    <TextBlock HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                               FontSize="20"
                               Foreground="{DynamicResource MenuSecondaryForegroundBrush}"
                               Text="&#xE8D6;">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Artwork}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Border>

            <StackPanel Grid.Column="1"
                        Margin="10,0,0,0"
                        VerticalAlignment="Center">
                <TextBlock FontFamily="{StaticResource AppFont}"
                           FontSize="13"
                           FontWeight="{StaticResource FontWeightEmphasis}"
                           Foreground="{DynamicResource MenuForegroundBrush}"
                           Text="{Binding Title}"
                           TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding Title}" />
                <TextBlock Margin="0,3,0,0"
                           FontFamily="{StaticResource AppFont}"
                           FontSize="12"
                           Foreground="{DynamicResource MenuSecondaryForegroundBrush}"
                           Text="{Binding Artist}"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock Margin="0,1,0,0"
                           FontFamily="{StaticResource AppFont}"
                           FontSize="11"
                           Foreground="{DynamicResource MenuSecondaryForegroundBrush}"
                           Opacity="0.75"
                           Text="{Binding Album}"
                           TextTrimming="CharacterEllipsis">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Album}" Value="">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </Grid>

        <!--  =====  进度条 + 时间  =====  -->
        <StackPanel x:Name="ProgressArea" Margin="0,0,0,4">
            <StackPanel.Style>
                <Style TargetType="StackPanel">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasDuration}" Value="False">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </StackPanel.Style>

            <Slider x:Name="ProgressSlider"
                    Height="14"
                    Maximum="{Binding DurationSeconds}"
                    Minimum="0"
                    Style="{StaticResource SettingsSlider}"
                    Thumb.DragStarted="OnSeekStarted"
                    Thumb.DragCompleted="OnSeekCompleted"
                    Value="{Binding PositionSeconds, Mode=TwoWay}" />

            <TextBlock Margin="0,2,0,0"
                       HorizontalAlignment="Right"
                       FontFamily="{StaticResource AppFont}"
                       FontSize="11"
                       Foreground="{DynamicResource MenuSecondaryForegroundBrush}"
                       Text="{Binding ProgressText}" />
        </StackPanel>

        <!--  =====  传输控制  =====  -->
        <StackPanel HorizontalAlignment="Center"
                    Orientation="Horizontal"
                    IsEnabled="{Binding HasTrack}">
            <Button Command="{Binding PreviousCommand}"
                    Content="&#xE892;"
                    Style="{StaticResource TransportButton}"
                    ToolTip="上一首" />
            <Button Margin="8,0"
                    Command="{Binding TogglePlayPauseCommand}"
                    Content="{Binding PlayPauseGlyph}"
                    Style="{StaticResource PrimaryTransportButton}"
                    ToolTip="播放 / 暂停" />
            <Button Command="{Binding NextCommand}"
                    Content="&#xE893;"
                    Style="{StaticResource TransportButton}"
                    ToolTip="下一首" />
        </StackPanel>

        <!--  无播放时的提示  -->
        <TextBlock Margin="0,8,0,0"
                   HorizontalAlignment="Center"
                   FontFamily="{StaticResource AppFont}"
                   FontSize="12"
                   Foreground="{DynamicResource MenuSecondaryForegroundBrush}"
                   Text="当前没有正在播放的媒体">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasTrack}" Value="False">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
    </StackPanel>
</UserControl>
