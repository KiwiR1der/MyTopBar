<Window x:Class="MyTopBar.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="clr-namespace:MyTopBar"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:fluent="https://github.com/TwilightLemon/FluentWpfCore"
        xmlns:views="clr-namespace:MyTopBar.Views"
        Title="MyTopBar"
        Height="30"
        AllowsTransparency="False"
        Background="Transparent"
        FontFamily="{StaticResource AppFont}"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType"
        Topmost="True"
        UseLayoutRounding="True"
        WindowStyle="None"
        mc:Ignorable="d">

    <!--  材质由 DWM 提供，本层必须完全透明，否则会遮住 Mica/Acrylic  -->
    <!--  材质交由 FluentWpfCore 管理（Acrylic / Mica / MicaAlt），可在运行时切换  -->
    <fluent:WindowMaterial.Material>
        <fluent:WindowMaterial x:Name="WindowMaterialConfig"
                               CompositonColor="#4DF2F2F2"
                               IsDarkMode="False"
                               MaterialMode="Acrylic"
                               UseWindowComposition="True" />
    </fluent:WindowMaterial.Material>

    <Grid x:Name="RootGrid" Background="Transparent">
        <!--
            IsSharedSizeScope + 两列同用 SharedSizeGroup：
            左右两列都按 Auto 取内容宽度，但会被强制成**二者中较大的那个**。
            这样既保证内容不被裁掉（原来固定 320px，右区实测要 ~490px），
            又让中区在屏幕上真正居中（若左右宽度不等，中区会偏到一侧）。
        -->
        <Grid Margin="12,0" Grid.IsSharedSizeScope="True">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" SharedSizeGroup="BarSide" />
                <!--  MinWidth 放在列上才有效；放在子元素上不会让 * 列保留空间  -->
                <ColumnDefinition Width="*" MinWidth="160" />
                <ColumnDefinition Width="Auto" SharedSizeGroup="BarSide" />
            </Grid.ColumnDefinitions>

            <!--  左区：Apple 菜单 + 当前活动应用  -->
            <StackPanel Grid.Column="0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                <Button x:Name="AppleButton"
                        Click="AppleButton_Click"
                        Style="{StaticResource AppleMenuButton}">
                    <Path Width="14"
                          Height="14"
                          Data="{StaticResource Apple}"
                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          RenderTransformOrigin="0.5,0.5"
                          SnapsToDevicePixels="True"
                          Stretch="Uniform">
                        <Path.RenderTransform>
                            <ScaleTransform ScaleX="1" ScaleY="-1" />
                        </Path.RenderTransform>
                    </Path>
                </Button>

                <TextBlock Margin="2,0,0,0"
                           MaxWidth="240"
                           Style="{StaticResource BarText}"
                           Text="{Binding CurrentAppName}"
                           ToolTip="{Binding CurrentWindowTitle}" />

                <Popup x:Name="AppleMenuPopup"
                       AllowsTransparency="True"
                       HorizontalOffset="-4"
                       Placement="Bottom"
                       PlacementTarget="{Binding ElementName=AppleButton}"
                       PopupAnimation="Fade"
                       StaysOpen="False"
                       VerticalOffset="6">
                    <Border Width="220"
                            Padding="6,4"
                            Background="{DynamicResource MenuBackgroundBrush}"
                            BorderBrush="{DynamicResource MenuBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="10">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="16"
                                              Direction="270"
                                              Opacity="0.28"
                                              ShadowDepth="6"
                                              Color="#000000" />
                        </Border.Effect>
                        <StackPanel>
                            <Button Command="{Binding AboutThisPcCommand}"
                                    Content="关于本机"
                                    Style="{StaticResource AppleMenuItem}" />
                            <Button Command="{Binding OpenSettingsCommand}"
                                    Content="系统设置"
                                    Style="{StaticResource AppleMenuItem}" />
                            <Button Command="{Binding OpenBarSettingsCommand}"
                                    Content="MyTopBar 设置…"
                                    Style="{StaticResource AppleMenuItem}" />
                            <Separator Style="{StaticResource AppleMenuSeparator}" />
                            <Button Command="{Binding SleepCommand}"
                                    Content="睡眠"
                                    Style="{StaticResource AppleMenuItem}" />
                            <Button Command="{Binding RestartCommand}"
                                    Content="重新启动…"
                                    Style="{StaticResource AppleMenuItem}" />
                            <Button Command="{Binding ShutdownCommand}"
                                    Content="关机…"
                                    Style="{StaticResource AppleMenuItem}" />
                            <Separator Style="{StaticResource AppleMenuSeparator}" />
                            <Button Command="{Binding ExitCommand}"
                                    Content="退出 MyTopBar"
                                    Style="{StaticResource AppleMenuItem}" />
                        </StackPanel>
                    </Border>
                </Popup>
            </StackPanel>

            <!--  中区：歌词 / 天气 / 时钟 / 文本  -->
            <!--
                中区：歌词 / 天气 / 时钟 / 文本。
                留一点最小宽度，屏幕极窄时优先保住中区可读性。
            -->
            <StackPanel x:Name="CenterPanel"
                        Grid.Column="1"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                <ItemsControl x:Name="CenterItems"
                              ItemTemplateSelector="{x:Null}"
                              ItemsSource="{Binding CenterWidgets}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemContainerStyle>
                        <Style TargetType="ContentPresenter">
                            <Setter Property="Margin" Value="9,0" />
                            <Setter Property="VerticalAlignment" Value="Center" />
                        </Style>
                    </ItemsControl.ItemContainerStyle>
                </ItemsControl>

            </StackPanel>

            <!--  右区：音量 + CPU / 内存 / 网络  -->
            <StackPanel x:Name="RightPanel"
                        Grid.Column="2"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                <Grid VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Separator Grid.Column="0" Style="{StaticResource AppleMenuSeparator}" />
                    <ItemsControl x:Name="RightItems" Grid.Column="1" ItemsSource="{Binding RightWidgets}" MouseLeftButtonUp="OnRightItemsClick">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemContainerStyle>
                            <Style TargetType="ContentPresenter">
                                <Setter Property="Margin" Value="9,0" />
                                <Setter Property="VerticalAlignment" Value="Center" />
                            </Style>
                        </ItemsControl.ItemContainerStyle>
                    </ItemsControl>
                </Grid>

                <!--  时钟日历弹窗：锚定右区面板，点击时钟区域弹出  -->
                <Popup x:Name="ClockPopup"
                       AllowsTransparency="True"
                       HorizontalOffset="-4"
                       Placement="Bottom"
                       PlacementTarget="{Binding ElementName=RightPanel}"
                       PopupAnimation="Fade"
                       StaysOpen="False"
                       VerticalOffset="6">
                    <Border MinWidth="248"
                            Padding="10,8"
                            Background="{DynamicResource MenuBackgroundBrush}"
                            BorderBrush="{DynamicResource MenuBorderBrush}"
                            BorderThickness="1"
                            ClipToBounds="False"
                            CornerRadius="10">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="16"
                                              Direction="270"
                                              Opacity="0.28"
                                              ShadowDepth="6"
                                              Color="Black" />
                        </Border.Effect>
                        <views:CalendarPopup />
                    </Border>
                </Popup>

                <!--  音量在最右侧（最外），网络等指标在其内侧  -->
                <Button x:Name="AudioButton"
                        Click="AudioButton_Click"
                        Style="{StaticResource AppleMenuButton}">
                    <StackPanel Orientation="Horizontal">
                        <Path Width="14"
                              Height="14"
                              Data="{StaticResource Volume}"
                              Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              RenderTransformOrigin="0.5,0.5"
                              SnapsToDevicePixels="True"
                              Stretch="Uniform" />
                        <TextBlock Margin="4,0,0,0"
                                   Style="{StaticResource BarSecondaryText}"
                                   Text="{Binding Volume, StringFormat={}{0:P0}}" />
                    </StackPanel>
                </Button>

                <Popup x:Name="AudioPopup"
                       AllowsTransparency="True"
                       HorizontalOffset="-4"
                       Placement="Bottom"
                       PlacementTarget="{Binding ElementName=AudioButton}"
                       PopupAnimation="Fade"
                       StaysOpen="False"
                       VerticalOffset="6">
                    <Border MinWidth="248"
                            Padding="10,8"
                            Background="{DynamicResource MenuBackgroundBrush}"
                            BorderBrush="{DynamicResource MenuBorderBrush}"
                            BorderThickness="1"
                            ClipToBounds="False"
                            CornerRadius="10">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="16"
                                              Direction="270"
                                              Opacity="0.28"
                                              ShadowDepth="6"
                                              Color="Black" />
                        </Border.Effect>
                        <views:AudioPopupView />
                    </Border>
                </Popup>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
