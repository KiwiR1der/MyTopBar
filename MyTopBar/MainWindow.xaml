<Window x:Class="MyTopBar.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:fluent="https://github.com/TwilightLemon/FluentWpfCore"
        xmlns:local="clr-namespace:MyTopBar"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:MyTopBar.Views"
        Title="MyTopBar"
        Height="30"
        Icon="pack://application:,,,/Assets/Icons/app.ico"
        fluent:DwmAnimation.EnableDwmAnimation="True"
        fluent:WindowMaterial.WindowCorner="DoNotRound"
        Background="Transparent"
        FontFamily="{DynamicResource AppFont}"
        ResizeMode="NoResize"
        ShowActivated="False"
        ShowInTaskbar="False"
        SnapsToDevicePixels="True"
        Topmost="True"
        WindowStyle="None"
        mc:Ignorable="d">

    <Window.Resources>
        <WindowChrome x:Key="BarWindowChrome"
                      CaptionHeight="0"
                      CornerRadius="0"
                      GlassFrameThickness="-1"
                      ResizeBorderThickness="0" />
    </Window.Resources>

    <fluent:WindowMaterial.Material>
        <fluent:WindowMaterial x:Name="windowMaterial"
                               MaterialMode="Acrylic"
                               UseWindowComposition="True"
                               WindowChromeEx="{StaticResource BarWindowChrome}" />
    </fluent:WindowMaterial.Material>

    <Grid x:Name="RootGrid" Background="Transparent">
        <!--
            IsSharedSizeScope + 两列同用 SharedSizeGroup：
            左右两列都按 Auto 取内容宽度，但会被强制成**二者中较大的那个**。
            这样既保证内容不被裁掉（原来固定 320px，右区实测要 ~490px），
            又让中区在屏幕上真正居中（若左右宽度不等，中区会偏到一侧）。
        -->
        <Grid Margin="12,0" Grid.IsSharedSizeScope="True">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" SharedSizeGroup="BarSide" />
                <!--  MinWidth 放在列上才有效；放在子元素上不会让 * 列保留空间  -->
                <ColumnDefinition Width="*" MinWidth="160" />
                <ColumnDefinition Width="Auto" SharedSizeGroup="BarSide" />
            </Grid.ColumnDefinitions>

            <!--  左区：Apple 菜单 + 当前活动应用  -->
            <StackPanel Grid.Column="0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                <Button x:Name="AppleButton"
                        Click="AppleButton_Click"
                        Style="{StaticResource AppleMenuButton}"
                        ToolTip="MyTopBar 菜单">
                    <!--
                        Apple 徽标：与其他图标同样 14x14、垂直居中。
                        
                        用 Path 而不是 Image，理由有两条：
                        1. 颜色要跟随主题。Fill 绑定按钮自身的 Foreground，
                        主题切换时 DynamicResource 重新解析，颜色自动更新；
                        若用 DrawingImage + Image，图片会被 Freeze，
                        主题切换后颜色不再跟随（之前黑色不随主题变就是这个原因）。
                        2. 尺寸要用 LayoutTransform 控制。原始路径的坐标系是上下
                        颠倒的（叶子在 Y 689..938，位于主体的下方），必须
                        ScaleY=-1 翻正。LayoutTransform 参与布局测量，
                        Stretch=Uniform 才能正确算出 14x14 的包围盒。
                    -->
                    <Path Width="14"
                          Height="14"
                          Data="{StaticResource Apple}"
                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          Stretch="Uniform">
                        <Path.LayoutTransform>
                            <ScaleTransform ScaleX="1" ScaleY="-1" />
                        </Path.LayoutTransform>
                    </Path>
                </Button>

                <TextBlock MaxWidth="240"
                           Margin="2,0,0,0"
                           Style="{StaticResource BarText}"
                           Text="{Binding CurrentAppName}"
                           ToolTip="{Binding CurrentWindowTitle}" />

            </StackPanel>

            <!--
                中区：歌词 / 天气 / 时钟 / 文本。
                实际同屏只有一个（歌词与一言互斥，见 MainViewModel.RefreshCenterWidget）。
                最小宽度写在列定义上（MinWidth=160），屏幕极窄时优先保住中区可读性。
            -->
            <StackPanel x:Name="CenterPanel"
                        Grid.Column="1"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                <!--
                    点击歌词组件弹出媒体控制浮窗。
                    用 PreviewMouseLeftButtonUp 而不是 Click：中区是模板化内容，
                    没有按钮可挂，只能在容器上拦。
                -->
                <ItemsControl x:Name="CenterItems"
                              ItemTemplateSelector="{x:Null}"
                              ItemsSource="{Binding CenterWidgets}"
                              PreviewMouseLeftButtonUp="OnCenterItemsClick">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemContainerStyle>
                        <Style TargetType="ContentPresenter">
                            <Setter Property="Margin" Value="9,0" />
                            <Setter Property="VerticalAlignment" Value="Center" />
                        </Style>
                    </ItemsControl.ItemContainerStyle>
                </ItemsControl>
            </StackPanel>

            <!--  右区：音量 + CPU / 内存 / 网络  -->
            <StackPanel x:Name="RightPanel"
                        Grid.Column="2"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                <Grid VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Separator Grid.Column="0" Style="{StaticResource AppleMenuSeparator}" />
                    <ItemsControl x:Name="RightItems"
                                  Grid.Column="1"
                                  ItemsSource="{Binding RightWidgets}"
                                  MouseLeftButtonUp="OnRightItemsClick">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemContainerStyle>
                            <Style TargetType="ContentPresenter">
                                <Setter Property="Margin" Value="9,0" />
                                <Setter Property="VerticalAlignment" Value="Center" />
                            </Style>
                        </ItemsControl.ItemContainerStyle>
                    </ItemsControl>
                </Grid>

                <!--
                    音量：与右区其他指标同一套「图标 + 数值」结构。
                    图标走 GaugeIcons.xaml 的彩色矢量（喇叭 + 声波），
                    不再用 IconsRC.xaml 里的单色 PathGeometry —— 单色剪影
                    在毛玻璃上辨识度低，也和旁边几个彩色图标不搭。
                -->
                <Button x:Name="AudioButton"
                        Click="AudioButton_Click"
                        Style="{StaticResource AppleMenuButton}"
                        ToolTip="点击打开音量控制">
                    <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                        <Image Source="{Binding VolumeIcon, Converter={StaticResource GaugeIconConverter}}" Style="{StaticResource WidgetIcon}" />
                        <TextBlock Margin="4,0,0,0"
                                   Style="{StaticResource BarSecondaryText}"
                                   Text="{Binding Volume, StringFormat={}{0:P0}}" />
                    </StackPanel>
                </Button>

            </StackPanel>
        </Grid>
    </Grid>
</Window>
