<Window x:Class="MyTopBar.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="clr-namespace:MyTopBar"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:MyTopBar.Views"
        Title="MainWindow"
        Height="28"
        Background="#F2F2F2"
        FontFamily="{StaticResource AppFont}"
        RenderOptions.ClearTypeHint="Enabled"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType"
        Topmost="True"
        UseLayoutRounding="True"
        WindowStyle="None"
        mc:Ignorable="d">
    <Border Background="#F2F2F2" BorderBrush="#33000000">

        <Grid Margin="12,0" ShowGridLines="False">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                <Button x:Name="AppleButton"
                        Click="AppleButton_Click"
                        Style="{StaticResource AppleMenuButton}">
                    <Path Width="14"
                          Height="14"
                          Data="{StaticResource Apple}"
                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          RenderTransformOrigin="0.5,0.5"
                          SnapsToDevicePixels="True"
                          Stretch="Uniform">
                        <Path.RenderTransform>
                            <ScaleTransform ScaleX="1" ScaleY="-1" />
                        </Path.RenderTransform>
                    </Path>
                </Button>

                <TextBlock Margin="2,0,0,0"
                           VerticalAlignment="Center"
                           FontFamily="{StaticResource AppFontMedium}"
                           FontSize="13"
                           FontWeight="Normal"
                           Foreground="#1D1D1F"
                           RenderOptions.ClearTypeHint="Enabled"
                           Text="{Binding CurrentAppName}"
                           TextOptions.TextFormattingMode="Ideal"
                           TextOptions.TextRenderingMode="ClearType"
                           TextTrimming="CharacterEllipsis"
                           TextWrapping="NoWrap"
                           ToolTip="{Binding CurrentWindowTitle}" />

                <Popup x:Name="AppleMenuPopup"
                       AllowsTransparency="True"
                       HorizontalOffset="-4"
                       Placement="Bottom"
                       PlacementTarget="{Binding ElementName=AppleButton}"
                       PopupAnimation="Fade"
                       StaysOpen="False"
                       VerticalOffset="6">
                    <Border Width="220"
                            Padding="6,4"
                            Background="#F7F7F7"
                            BorderBrush="#33000000"
                            BorderThickness="1"
                            CornerRadius="10">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="16"
                                              Direction="270"
                                              Opacity="0.28"
                                              ShadowDepth="6"
                                              Color="#000000" />
                        </Border.Effect>
                        <StackPanel>
                            <Button Command="{Binding AboutThisPcCommand}"
                                    Content="关于本机"
                                    Style="{StaticResource AppleMenuItem}" />
                            <Button Command="{Binding OpenSettingsCommand}"
                                    Content="系统设置"
                                    Style="{StaticResource AppleMenuItem}" />
                            <Separator Style="{StaticResource AppleMenuSeparator}" />
                            <Button Command="{Binding SleepCommand}"
                                    Content="睡眠"
                                    Style="{StaticResource AppleMenuItem}" />
                            <Button Command="{Binding RestartCommand}"
                                    Content="重新启动…"
                                    Style="{StaticResource AppleMenuItem}" />
                            <Button Command="{Binding ShutdownCommand}"
                                    Content="关机…"
                                    Style="{StaticResource AppleMenuItem}" />
                            <Separator Style="{StaticResource AppleMenuSeparator}" />
                            <Button Command="{Binding ExitCommand}"
                                    Content="退出 MyTopBar"
                                    Style="{StaticResource AppleMenuItem}" />
                        </StackPanel>
                    </Border>
                </Popup>

            </StackPanel>

            <StackPanel Grid.Column="2"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">

                <Button x:Name="AudioButton" Style="{StaticResource AppleMenuButton}" Click="AudioButton_Click">
                    <StackPanel Orientation="Horizontal">
                        <Path Width="14"
                              Height="14"
                              Data="{StaticResource Volume}"
                              Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              RenderTransformOrigin="0.5,0.5"
                              SnapsToDevicePixels="True"
                              Stretch="Uniform" />
                        <TextBlock Margin="4,0,0,0"
                                   VerticalAlignment="Center"
                                   Text="{Binding Volume, StringFormat={}{0:P0}}" />
                    </StackPanel>
                </Button>

                <Popup x:Name="AudioPopup"
                       AllowsTransparency="True"
                       HorizontalOffset="-4"
                       Placement="Bottom"
                       PlacementTarget="{Binding ElementName=AudioButton}"
                       PopupAnimation="Fade"
                       StaysOpen="False"
                       VerticalOffset="6">
                    <Border MinWidth="248"
                            Padding="10,8"
                            Background="#F7F7F7"
                            BorderBrush="#33000000"
                            BorderThickness="1"
                            ClipToBounds="False"
                            CornerRadius="10">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="16"
                                              Direction="270"
                                              Opacity="0.28"
                                              ShadowDepth="6"
                                              Color="#000000" />
                        </Border.Effect>
                        <views:AudioPopupView />
                    </Border>
                </Popup>

                <Button x:Name="ClockButton"
                        Click="ClockButton_Click"
                        Style="{StaticResource AppleMenuButton}">
                    <TextBlock HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontFamily="{StaticResource AppFontMedium}"
                               Text="{Binding ClockText}" />
                </Button>

                <Popup x:Name="ClockPopup"
                       AllowsTransparency="True"
                       HorizontalOffset="-4"
                       Placement="Bottom"
                       PlacementTarget="{Binding ElementName=ClockButton}"
                       PopupAnimation="Fade"
                       StaysOpen="False"
                       VerticalOffset="6">
                    <Border MinWidth="248"
                            Padding="10,8"
                            Background="#F7F7F7"
                            BorderBrush="#33000000"
                            BorderThickness="1"
                            ClipToBounds="False"
                            CornerRadius="10">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="16"
                                              Direction="270"
                                              Opacity="0.28"
                                              ShadowDepth="6"
                                              Color="#000000" />
                        </Border.Effect>
                        <views:CalendarPopup />
                    </Border>
                </Popup>

            </StackPanel>
        </Grid>

    </Border>

</Window>
